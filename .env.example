# Dockhand Discord Control — environment configuration
# Copy to .env and fill values. Runtime overrides may also be stored in SQLite
# via the Reflex UI.

# Dockhand API
DOCKHAND_BASE_URL=http://dockhand:8080
DOCKHAND_API_TOKEN=

# Discord bot (slash commands)
DISCORD_BOT_TOKEN=
# Optional: Discord guild (server) ID to scope slash command registration
DISCORD_GUILD_ID=
